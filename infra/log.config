version: 1
formatters:
  minimal:
    format: '%(asctime)s %(levelname)s %(name)s %(message)s'
handlers:
  console:
    class: logging.StreamHandler
    formatter: minimal
loggers:
  synapse.access.http.8008:
    level: CRITICAL
root:
  level: WARNING
  handlers: [console]
disable_existing_loggers: false
